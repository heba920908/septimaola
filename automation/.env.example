# AI Provider selection
# Valid values: "deepseek" (default) or "codemie"
AI_PROVIDER=deepseek

# -------------------------------------------------------------------
# Deepseek AI (when AI_PROVIDER=deepseek)
# Sign up at https://platform.deepseek.com/
# -------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# -------------------------------------------------------------------
# Codemie AI (when AI_PROVIDER=codemie)
# Requires a Keycloak client_credentials setup.
# See: https://docs.codemie.ai/user-guide/api/client-secret-access/
# -------------------------------------------------------------------
CODEMIE_BASE_URL=https://codemie.example.com
CODEMIE_TOKEN_URL=https://auth.codemie.lab.example.com/realms/codemie-prod/protocol/openid-connect/token
CODEMIE_CLIENT_ID=your_client_id_here
CODEMIE_CLIENT_SECRET=your_client_secret_here
# Optional: Codemie Chat Completions model (default: gpt-4.1)
CODEMIE_MODEL=gpt-4.1

# -------------------------------------------------------------------
# Facebook App (optional, for OAuth bootstrap / validation)
# See automation/README.md for credential setup instructions
# -------------------------------------------------------------------
FACEBOOK_APP_CLIENT_ID=your_app_client_id_here
FACEBOOK_APP_CLIENT_SECRET=your_app_client_secret_here

# -------------------------------------------------------------------
# Enable Facebook publishing
# Set this to 1 to allow posts to be created on Facebook by default.
# Facebook publishing is disabled by default unless --facebook is passed.
# -------------------------------------------------------------------
ENABLE_FACEBOOK=0

# -------------------------------------------------------------------
# Facebook Page publishing
# See automation/README.md for credential setup instructions
# -------------------------------------------------------------------
FACEBOOK_PAGE_ID=your_page_id_here
FACEBOOK_ACCESS_TOKEN=your_page_access_token_here

# -------------------------------------------------------------------
# Instagram (via Facebook Graph API)
# See automation/README.md for credential setup instructions
# -------------------------------------------------------------------
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here
